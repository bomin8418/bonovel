#!/usr/bin/env sh
# bonovel — POSIX (macOS/Linux) 免 pip 安装全局启动脚本。
# 用法：bonovel [小说.txt] [-d 目录]
# 委托项目根目录 run.py 启动（自动定位 src，无需 PYTHONPATH）。

# 项目根：脚本通常放在 <项目根>/bin/ 下
SELF="$0"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
PROJECT_DIR="$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)"

# 选择可用的 Python 解释器：探测真实可运行者（避免 Windows 的 python3 占位别名）。
for PY in python3 python; do
  if command -v "$PY" >/dev/null 2>&1 && "$PY" -c "import sys" >/dev/null 2>&1; then
    exec "$PY" "$PROJECT_DIR/run.py" "$@"
  fi
done
echo "bonovel: 未找到可运行的 python3/python，请先安装 Python 3.9+" >&2
exit 1
